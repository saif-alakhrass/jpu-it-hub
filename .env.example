# Public frontend configuration only. Copy to .env and replace placeholders.
# Never put Cloudflare R2 or Supabase service-role credentials in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# In Vercel, use /api/storage so browser requests stay same-origin and Vercel
# proxies them to the Cloudflare Worker. For local development, use the Worker URL.
VITE_R2_WORKER_URL=/api/storage
