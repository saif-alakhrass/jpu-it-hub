# Frontend (exposed to the browser via VITE_ prefix)
# These are safe to expose — they are the public anon/publishable key, not the service role key.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only (edge functions, scripts). NEVER prefix with VITE_.
# These must NOT be referenced in any client-side code.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
