# Browser-safe values
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_R2_WORKER_URL=https://YOUR_STAGING_WORKER.workers.dev

# Keep false in production until the staging pilot is approved.
VITE_MOODLE_AUTH_ENABLED=false

# Local development can proxy the Worker and avoid browser CORS noise.
R2_WORKER_PROXY_TARGET=http://127.0.0.1:8787
